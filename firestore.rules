rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Submission deadline: 30 Aug 2026, 14:45 Israel time (IDT = UTC+3),
    // which is 11:45 UTC. Keep this in sync with DEADLINE in index.html.
    function afterDeadline() {
      return request.time >
             timestamp.date(2026, 8, 30) + duration.time(11, 45, 0, 0);
    }

    // A player may WRITE their OWN guess only until the deadline — after it
    // passes, submissions are frozen (enforced here, not just in the UI, so it
    // can't be bypassed via the console or raw API).
    // Reading ANYONE ELSE's guess (a single get, or listing the whole
    // collection) is blocked until the deadline passes — so nobody can peek at
    // others' tables while submissions are still open.
    match /predictions/{uid} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && !afterDeadline();
      allow read:  if request.auth != null
                   && (request.auth.uid == uid || afterDeadline());
    }

    // The real, admin-maintained league table. Anyone signed in can read it;
    // only the admin account may write it.
    match /meta/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'eldar71191@gmail.com';
    }

    // Leaderboard snapshots (one per admin table update) powering the
    // rank-over-time chart. Anyone signed in reads; only the admin writes.
    // These are only ever created after the season starts (post-deadline),
    // and hold scores only — never the raw predictions.
    match /history/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'eldar71191@gmail.com';
    }
  }
}
